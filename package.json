{
  "name": "makerfox-studio",
  "version": "2.0.0",
  "description": "MakerFox Studio - Costeo rentable y catálogo de impresión 3D",
  "main": "main.js",
  "author": "MakerFox",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "publish": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.makerfox.studio",
    "productName": "MakerFox Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/makerfox-studio-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/makerfox-studio-icon.ico",
      "uninstallerIcon": "assets/makerfox-studio-icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "NestorJm21",
        "repo": "MakerFox-Desktop",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "electron-updater": "^6.6.2"
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "electron-winstaller@5.4.0": true
  }
}
